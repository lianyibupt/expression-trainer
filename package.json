{
  "name": "expression-trainer",
  "productName": "智能表达训练",
  "version": "1.0.0",
  "description": "智能表达训练系统 - 本地桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "check:opensmile": "${OPENSMILE_PYTHON:-${QWEN3_ASR_PYTHON:-.venv-qwen3-asr/bin/python}} -c 'import opensmile; print(\"openSMILE ready\")'",
    "check:qwen3-asr": "QWEN3_ASR_PYTHON=.venv-qwen3-asr/bin/python .venv-qwen3-asr/bin/python scripts/qwen3_asr_worker.py --model Qwen/Qwen3-ASR-1.7B --check",
    "build:system-audio-helper": "cd native/system-audio-helper && CLANG_MODULE_CACHE_PATH=$(pwd)/.build/clang-module-cache swift build --cache-path $(pwd)/.build/swiftpm-cache",
    "probe:system-audio": "cd native/system-audio-helper && .build/debug/system-audio-probe --duration 10 --out /tmp/system-audio-probe.wav"
  },
  "keywords": [
    "expression",
    "training",
    "speech",
    "asr",
    "chinese"
  ],
  "author": "sisi",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "dependencies": {
    "sherpa-onnx-darwin-arm64": "^1.13.3",
    "sherpa-onnx-node": "^1.13.3"
  }
}
