{
  "name": "expression-trainer",
  "productName": "宇宙无敌表达训练",
  "version": "1.0.0",
  "description": "宇宙无敌表达训练系统 - 本地桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "build:system-audio-helper": "cd native/system-audio-helper && swift build",
    "probe:system-audio": "cd native/system-audio-helper && .build/debug/system-audio-probe --duration 10 --out /tmp/system-audio-probe.wav"
  },
  "keywords": ["expression", "training", "speech", "asr", "chinese"],
  "author": "sisi",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.10.0"
  }
}
